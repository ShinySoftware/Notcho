<Project Sdk="Microsoft.NET.Sdk">
    <!-- Everything the notch is that isn't tied to an OS: the views, the controller, Settings and the
         services on top of the Platform interfaces. Plain net11.0, so the macOS, Windows and GTK heads all
         take it; each head supplies the Platform implementations.

         No UseMaui, as in maui-labs' template: on plain net11.0 it only sends the SDK looking for a MAUI
         workload, and on Linux (where the release builds the GTK head) the one it asks for is maui-tizen.
         The Microsoft.Maui.Controls package brings the MAUI global usings without it, and there's no XAML
         or resources here for the workload to process. -->
    <PropertyGroup>
        <ShinyDIExtensionMethodName>AddNotchoServices</ShinyDIExtensionMethodName>
        <ShinyDIExtensionNamespace>Notcho</ShinyDIExtensionNamespace>
        <TargetFramework>net11.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <RootNamespace>Notcho</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Shiny.Audio" />
        <PackageReference Include="Shiny.Calendar" />
        <PackageReference Include="Shiny.Core" />
        <PackageReference Include="Shiny.Extensions.Stores" />
        <PackageReference Include="Shiny.Maui.Controls" />
        <PackageReference Include="Shiny.Maui.Controls.Camera" />
        <PackageReference Include="Shiny.Maui.Controls.Analysis.Barcode" />
        <PackageReference Include="Shiny.Maui.Controls.Desktop" />
        <PackageReference Include="Shiny.Maui.Controls.Markdown" />
        <PackageReference Include="Shiny.Speech" />
    </ItemGroup>

    <ItemGroup>
        <!-- For the top of Settings on every head: a 256 px copy of src/Notcho/Resources/AppIcon/appicon.png
             (sips -z 256 256 ... after the icon changes). -->
        <EmbeddedResource Include="Resources/AppIcon.png" LogicalName="Notcho.AppIcon.png" />
    </ItemGroup>

    <ItemGroup>
        <!-- The heads build platform tabs (macshot's Capture tab) from the same Ui helpers. -->
        <InternalsVisibleTo Include="Notcho" />
        <InternalsVisibleTo Include="Notcho.Windows" />
        <InternalsVisibleTo Include="Notcho.Linux" />
    </ItemGroup>
</Project>
